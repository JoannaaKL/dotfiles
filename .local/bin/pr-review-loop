#!/usr/bin/env bash
#
# pr-review-loop — iterate review and fix on a GitHub PR until it passes.
#
# One reviewer agent assesses the diff and writes a verdict. If the verdict is
# FAIL, a fixer agent addresses every finding and commits. The loop repeats,
# drawing a fresh pair of distinct models each round, until the reviewer
# returns PASS or MAX_ITERS is reached.
#
# The reviewer and fixer share one checkout so each round sees the last round's
# commits. To run either agent on its own, use pr-review and
# pr-address-feedback instead.
#
# Usage:
#   pr-review-loop <pr-url> [max-iters]
#
# Examples:
#   pr-review-loop https://github.com/github/github-mcp-server/pull/42
#   pr-review-loop https://github.com/github/github-mcp-server/pull/42 8
#
# Exits 0 on PASS, 2 when MAX_ITERS is hit, 1 on setup errors.

set -euo pipefail

# Locate and source the shared library (works symlinked or in-repo).
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
# shellcheck source=/dev/null
source "$BIN_DIR/../lib/pr-review-lib.sh"

PR_URL="${1:?usage: pr-review-loop <pr-url> [max-iters]}"
MAX_ITERS="${2:-6}"

require_tools
require_model_pool
if (( ${#MODEL_POOL[@]} < 2 )); then
  echo "ERROR: the loop needs at least 2 models (have ${#MODEL_POOL[@]})" >&2
  exit 1
fi

WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pr-review-loop.XXXXXX")"
KEEP_WORK_DIR=false
trap 'if [[ "$KEEP_WORK_DIR" != true ]]; then rm -rf -- "$WORK_DIR"; fi' EXIT
clone_pr "$PR_URL" "$WORK_DIR"

STATE_DIR="$WORK_DIR/.pr-review"
mkdir -p "$STATE_DIR"
VERDICT_FILE="$STATE_DIR/review.json"

for (( i=1; i<=MAX_ITERS; i++ )); do
  read -r REVIEWER_MODEL FIXER_MODEL <<< "$(pick_two_models)"
  log "Round $i/$MAX_ITERS — reviewing $BASE_REF...HEAD (reviewer: $REVIEWER_MODEL, fixer: $FIXER_MODEL)"

  review_pr "$REVIEWER_MODEL" "$BASE_REF" "$VERDICT_FILE"
  print_verdict "$VERDICT_FILE"

  if [[ "$VERDICT" == "PASS" ]]; then
    log "✅ PR approved by reviewer on round $i. Stopping."
    exit 0
  fi

  log "Round $i — fixer addressing $NFIND finding(s)"
  KEEP_WORK_DIR=true
  address_feedback "$FIXER_MODEL" "$VERDICT_FILE"
done

log "⚠️  Reached MAX_ITERS ($MAX_ITERS) without a PASS verdict."
log "Last verdict file: $VERDICT_FILE"
exit 2
